#!/usr/bin/env bpftrace
/*
 * scd_execve.bt — eBPF Hook for Suspicious Command Detector
 *
 * This bpftrace script hooks tracepoint:syscalls:sys_enter_execve
 * and captures the executed command along with its arguments.
 * It formats the output so it can be piped directly into SCD.
 *
 * Usage:
 *   sudo ./scd_execve.bt | scd
 */

#include <linux/sched.h>

BEGIN
{
    printf("SCD eBPF Hook Started. Monitoring execve()...\n");
}

tracepoint:syscalls:sys_enter_execve
{
    // Capture the command name and the full array of arguments
    $cmd = str(args->filename);
    
    // NOTE: bpftrace has limitations on looping over argv arrays directly
    // dynamically, but join() will join up to a limit of arguments.
    $argv_str = join(args->argv);

    // Output formatted string to stdout
    printf("%s\n", $argv_str);
}
